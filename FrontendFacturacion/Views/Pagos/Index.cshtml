@model List<FrontendFacturacion.Services.PagoDto>

@{
    ViewData["Title"] = "Pagos";

    var totalPagos = Model.Sum(p => p.MontoPago);
}

<div class="page-title">
    <partial name="_FormFeedback" />
    <div>
        <h2>Pagos</h2>
        <p>Visualización y registro de pagos recibidos.</p>
    </div>

    <a asp-controller="Pagos" asp-action="Create" class="btn btn-primary">Registrar pago</a>
</div>

<div class="grid grid-2">
    <div class="card">
        <div class="stat-title">Total pagos</div>
        <div class="stat-number">Q@(totalPagos.ToString("N2"))</div>
        <div class="stat-note">Registrados</div>
    </div>

    <div class="card">
        <div class="stat-title">Registros</div>
        <div class="stat-number">@Model.Count</div>
        <div class="stat-note">Pagos en sistema</div>
    </div>
</div>

<br />

<div class="table-card">
    <div class="table-header">
        <h3>Últimos pagos registrados</h3>

        <form method="get" class="search-form">
            <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por factura, método o referencia..." />
            <button class="btn btn-outline" type="submit">Buscar</button>
            <a asp-action="Index" class="btn btn-outline">Limpiar</a>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Factura</th>
                <th>Fecha de pago</th>
                <th class="text-right">Monto</th>
                <th>Método</th>
                <th>Referencia</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pago in Model)
            {
                <tr>
                    <td>@pago.IdPago</td>
                    <td>@pago.NumeroFactura</td>
                    <td>@pago.FechaPago.ToString("dd/MM/yyyy")</td>
                    <td class="text-right">Q@(pago.MontoPago.ToString("N2"))</td>
                    <td>@pago.MetodoPago</td>
                    <td>@pago.NumeroReferenciaPago</td>
                    <td>
                        <div class="actions">
                            <a asp-controller="Pagos" asp-action="Edit" asp-route-id="@pago.IdPago" class="action-btn">Editar</a>

                            <form asp-controller="Pagos" asp-action="Delete" asp-route-id="@pago.IdPago" method="post" class="inline-form">
                                <button class="action-btn" type="submit" onclick="return confirm('¿Eliminar pago?')">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>