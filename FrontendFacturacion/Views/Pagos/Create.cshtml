@using FrontendFacturacion.Services
@model FrontendFacturacion.Services.PagoDto

@{
    ViewData["Title"] = "Registrar Pago";

    var facturas = ViewBag.Facturas as List<FacturaDto> ?? new();
    int? idFacturaSeleccionada = ViewBag.IdFacturaSeleccionada as int?;
}

<div class="page-title">
    <div>
        <h2>Registrar Pago</h2>
        <p>Formulario para registrar el pago de una factura.</p>
    </div>

    <a asp-controller="Pagos" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<div class="form-card">
    <form asp-controller="Pagos" asp-action="Create" method="post">
        <div class="form-section">
            <h3>Datos del pago</h3>

            <div class="grid grid-3">
                <div class="form-group">
                    <label>Factura</label>
                    <select asp-for="IdFacturaPago" required>
                        <option value="">Seleccione una factura</option>

                        @foreach (var factura in facturas)
                        {
                            if (idFacturaSeleccionada == factura.IdFactura)
                            {
                                <option value="@factura.IdFactura" selected>@factura.NumeroFactura - @factura.Cliente</option>
                            }
                            else
                            {
                                <option value="@factura.IdFactura">@factura.NumeroFactura - @factura.Cliente</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Fecha de pago</label>
                    <input asp-for="FechaPago" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="form-group">
                    <label>Monto</label>
                    <input asp-for="MontoPago" type="number" value="150.00" step="0.01" min="0" required />
                </div>

                <div class="form-group">
                    <label>Método de pago</label>
                    <select asp-for="MetodoPago" required>
                        <option>EFECTIVO</option>
                        <option>TARJETA</option>
                        <option>TRANSFERENCIA</option>
                        <option>DEPOSITO</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Número de referencia</label>
                    <input asp-for="NumeroReferenciaPago" placeholder="Ejemplo: CAJA-01 o TRX-001" />
                </div>
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Pagos" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar pago</button>
        </div>
    </form>
</div>