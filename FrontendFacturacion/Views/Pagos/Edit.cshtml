@using FrontendFacturacion.Services
@using System.Globalization
@model FrontendFacturacion.Services.PagoDto

@{
    ViewData["Title"] = "Editar Pago";
    var facturas = ViewBag.Facturas as List<FacturaDto> ?? new();
}

<div class="page-title">
    <div>
        <h2>Editar Pago</h2>
        <p>Modificación de pago registrado.</p>
    </div>

    <a asp-controller="Pagos" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<partial name="_FormFeedback" />

<div class="form-card">
    <form asp-controller="Pagos" asp-action="Edit" asp-route-id="@Model.IdPago" method="post">
        <div class="form-section">
            <h3>Datos del pago</h3>

            <div class="grid grid-3">
                <div class="form-group">
                    <label>ID Pago</label>
                    <input asp-for="IdPago" readonly />
                </div>

                <div class="form-group">
                    <label>Factura</label>
                    <select asp-for="IdFacturaPago" required>
                        <option value="">Seleccione una factura</option>
                        @foreach (var factura in facturas)
                        {
                            <option value="@factura.IdFactura">@factura.NumeroFactura - @factura.Cliente</option>
                        }
                    </select>
                    <span asp-validation-for="IdFacturaPago" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Fecha de pago</label>
                    <input asp-for="FechaPago"
                           type="date"
                           data-no-futuro="true"
                           required />
                    <span asp-validation-for="FechaPago" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Monto</label>
                    <input asp-for="MontoPago"
                           type="number"
                           value="@Model.MontoPago.ToString("0.00", CultureInfo.InvariantCulture)"
                           step="any"
                           min="0"
                           inputmode="decimal"
                           lang="en-US"
                           data-decimal-positivo="true"
                           required />
                    <span asp-validation-for="MontoPago" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Método de pago</label>
                    <select asp-for="MetodoPago" required>
                        <option value="">Seleccione</option>
                        <option>EFECTIVO</option>
                        <option>TARJETA</option>
                        <option>TRANSFERENCIA</option>
                        <option>DEPOSITO</option>
                    </select>
                    <span asp-validation-for="MetodoPago" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Número de referencia</label>
                    <input asp-for="NumeroReferenciaPago"
                           maxlength="100"
                           data-referencia="true" />
                    <span asp-validation-for="NumeroReferenciaPago" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Pagos" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}