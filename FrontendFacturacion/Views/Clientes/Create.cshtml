@model FrontendFacturacion.Services.ClienteDto

@{
    ViewData["Title"] = "Registrar Cliente";
}

<div class="page-title">
    <div>
        <h2>Registrar Cliente</h2>
        <p>Formulario para registrar clientes.</p>
    </div>

    <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<partial name="_FormFeedback" />

<div class="form-card">
    <form asp-controller="Clientes" asp-action="Create" method="post">
        <div class="form-section">
            <h3>Datos del cliente</h3>

            <div class="grid grid-3">
                <div class="form-group">
                    <label>DPI</label>
                    <input asp-for="DpiCliente"
                           type="text"
                           maxlength="13"
                           inputmode="numeric"
                           data-solo-numeros="true"
                           placeholder="Ejemplo: 2548963210101"
                           required />
                    <span asp-validation-for="DpiCliente" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>NIT</label>
                    <input asp-for="NitCliente"
                           type="text"
                           maxlength="10"
                           inputmode="numeric"
                           data-formato-nit="true"
                           placeholder="Ejemplo: 1234567-8"
                           required />
                    <span asp-validation-for="NitCliente" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Nombre</label>
                    <input asp-for="NombreCliente"
                           type="text"
                           maxlength="50"
                           data-solo-letras="true"
                           placeholder="Nombre del cliente"
                           required />
                    <span asp-validation-for="NombreCliente" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Apellido</label>
                    <input asp-for="ApellidoCliente"
                           type="text"
                           maxlength="100"
                           data-solo-letras="true"
                           placeholder="Apellido del cliente"
                           required />
                    <span asp-validation-for="ApellidoCliente" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Correo</label>
                    <input asp-for="CorreoCliente"
                           type="email"
                           maxlength="150"
                           placeholder="cliente@correo.com" />
                    <span asp-validation-for="CorreoCliente" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Teléfono</label>
                    <input asp-for="TelefonoCliente"
                           type="text"
                           maxlength="9"
                           inputmode="numeric"
                           data-formato-telefono="true"
                           placeholder="5555-1234"
                           required />
                    <span asp-validation-for="TelefonoCliente" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar cliente</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}