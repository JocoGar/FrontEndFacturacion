@{
    ViewData["Title"] = "Registrar Cliente";
}

<div class="page-title">
    <div>
        <h2>Registrar Cliente</h2>
        <p>Formulario preparado para registrar clientes.</p>
    </div>

    <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<div class="form-card">
    <div class="form-section">
        <h3>Datos del cliente</h3>

        <div class="grid grid-3">
            <div class="form-group">
                <label>DPI</label>
                <input type="text" maxlength="13" placeholder="Ejemplo: 2548963210101" />
            </div>

            <div class="form-group">
                <label>Nombre</label>
                <input type="text" placeholder="Nombre del cliente" />
            </div>

            <div class="form-group">
                <label>Apellido</label>
                <input type="text" placeholder="Apellido del cliente" />
            </div>

            <div class="form-group">
                <label>Correo</label>
                <input type="email" placeholder="cliente@correo.com" />
            </div>

            <div class="form-group">
                <label>Teléfono</label>
                <input type="text" placeholder="5555-1234" />
            </div>

            <div class="form-group">
                <label>Fecha de creación</label>
                <input type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
        </div>
    </div>

    <div class="actions">
        <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline">Cancelar</a>
        <button class="btn btn-primary">Guardar cliente</button>
    </div>
</div>