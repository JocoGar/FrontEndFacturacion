@model FrontendFacturacion.Services.ClienteDto

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="page-title">
    <div>
        <h2>Editar Cliente</h2>
        <p>Modificación de datos del cliente.</p>
    </div>

    <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<div class="form-card">
    <form asp-controller="Clientes" asp-action="Edit" asp-route-id="@Model.DpiCliente" method="post">
        <div class="form-section">
            <h3>Datos del cliente</h3>

            <div class="grid grid-3">
                <div class="form-group">
                    <label>DPI</label>
                    <input asp-for="DpiCliente" readonly />
                </div>

                <div class="form-group">
                    <label>Nombre</label>
                    <input asp-for="NombreCliente" />
                </div>

                <div class="form-group">
                    <label>Apellido</label>
                    <input asp-for="ApellidoCliente" />
                </div>

                <div class="form-group">
                    <label>Correo</label>
                    <input asp-for="CorreoCliente" type="email" />
                </div>

                <div class="form-group">
                    <label>Teléfono</label>
                    <input asp-for="TelefonoCliente" />
                </div>
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar cambios</button>
        </div>
    </form>
</div>