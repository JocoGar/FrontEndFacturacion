@model List<FrontendFacturacion.Services.ClienteDto>

@{
    ViewData["Title"] = "Clientes";
}

<div class="page-title">
    <div>
        <h2>Clientes</h2>
        <p>Registro y administración de clientes.</p>
    </div>

    <a asp-controller="Clientes" asp-action="Create" class="btn btn-primary">Registrar cliente</a>
</div>

<div class="table-card">
    <div class="table-header">
        <h3>Listado de clientes</h3>

        <form method="get" class="search-form">
            <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por DPI, nombre o correo..." />
            <button class="btn btn-outline" type="submit">Buscar</button>
            <a asp-action="Index" class="btn btn-outline">Limpiar</a>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>DPI</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Fecha creación</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.DpiCliente</td>
                    <td>@cliente.NombreCliente</td>
                    <td>@cliente.ApellidoCliente</td>
                    <td>@cliente.CorreoCliente</td>
                    <td>@cliente.TelefonoCliente</td>
                    <td>@cliente.FechaCreacionCliente.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="actions">
                            <a asp-controller="Clientes" asp-action="Edit" asp-route-id="@cliente.DpiCliente" class="action-btn">Editar</a>

                            <form asp-controller="Clientes" asp-action="Delete" asp-route-id="@cliente.DpiCliente" method="post" class="inline-form">
                                <button class="action-btn" type="submit" onclick="return confirm('¿Eliminar cliente?')">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>