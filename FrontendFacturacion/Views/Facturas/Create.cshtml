@using FrontendFacturacion.Services
@using System.Globalization
@model FrontendFacturacion.Services.FacturaCrearViewModel

@{
    ViewData["Title"] = "Nueva Factura";

    var clientes = ViewBag.Clientes as List<ClienteDto> ?? new();
    var productos = ViewBag.Productos as List<ProductoDto> ?? new();
    var usuarios = ViewBag.Usuarios as List<UsuarioDto> ?? new();

    var numeroFacturaInterno = string.IsNullOrWhiteSpace(Model.NumeroFactura)
        ? $"F-{DateTime.Now:yyyyMMddHHmmss}"
        : Model.NumeroFactura;

    var fechaFactura = Model.FechaEmisionFactura == default
        ? DateTime.Today
        : Model.FechaEmisionFactura;

    var detalles = Model.Detalles != null && Model.Detalles.Any()
        ? Model.Detalles
        : new List<DetalleFacturaCrearDto>
        {
            new DetalleFacturaCrearDto
            {
                CantidadDetalleFactura = 1,
                PrecioUnitarioDetalleFactura = 0
            }
        };

    var clienteSeleccionadoExiste = clientes.Any(c => c.IdCliente == Model.IdClienteFactura);
    var usuarioSeleccionadoExiste = usuarios.Any(u => u.DpiUsuario == Model.DpiUsuarioFactura);
}

<div class="page-title">
    <div>
        <h2>Crear Nueva Factura</h2>
        <p>Complete los datos generales y el detalle de productos o servicios.</p>
    </div>

    <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<partial name="_FormFeedback" />

<div class="form-card">
    <form asp-controller="Facturas" asp-action="Create" method="post">
        <input asp-for="NumeroFactura" type="hidden" value="@numeroFacturaInterno" />

        <div class="form-section">
            <h3>1. Datos generales</h3>

            <div class="grid grid-3">
                <div class="form-group">
                    <label>Cliente</label>
                    <select asp-for="IdClienteFactura" required>
                        <option value="">Seleccione un cliente</option>

                        @if (Model.IdClienteFactura > 0 && !clienteSeleccionadoExiste)
                        {
                            <option value="@Model.IdClienteFactura" selected>Cliente seleccionado</option>
                        }

                        @foreach (var cliente in clientes)
                        {
                            <option value="@cliente.IdCliente">
                                @cliente.IdCliente - @cliente.NombreCliente @cliente.ApellidoCliente - NIT: @cliente.NitCliente
                            </option>
                        }
                    </select>
                    <span asp-validation-for="IdClienteFactura" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Usuario vendedor</label>
                    <select asp-for="DpiUsuarioFactura" required>
                        <option value="">Seleccione un usuario</option>

                        @if (!string.IsNullOrWhiteSpace(Model.DpiUsuarioFactura) && !usuarioSeleccionadoExiste)
                        {
                            <option value="@Model.DpiUsuarioFactura" selected>Usuario seleccionado</option>
                        }

                        @foreach (var usuario in usuarios)
                        {
                            <option value="@usuario.DpiUsuario">
                                @usuario.NombreUsuario @usuario.ApellidoUsuario
                            </option>
                        }
                    </select>
                    <span asp-validation-for="DpiUsuarioFactura" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Moneda</label>
                    <select asp-for="MonedaFactura" required>
                        <option value="GTQ">GTQ</option>
                    </select>
                    <span asp-validation-for="MonedaFactura" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Fecha de emisión</label>
                    <input asp-for="FechaEmisionFactura"
                           type="date"
                           value="@fechaFactura.ToString("yyyy-MM-dd")"
                           data-no-futuro="true"
                           required />
                    <span asp-validation-for="FechaEmisionFactura" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Número de factura</label>
                    <input type="text" value="Generado automáticamente" readonly />
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3>2. Detalle de productos o servicios</h3>

            <table id="tablaDetalle">
                <thead>
                    <tr>
                        <th>Producto / Servicio</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-right">Precio unitario</th>
                        <th class="text-right">Acción</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < detalles.Count; i++)
                    {
                        var detalle = detalles[i];
                        var productoSeleccionadoExiste = productos.Any(p => p.CodigoProducto == detalle.CodigoProductoDetalleFactura);

                        <tr>
                            <td>
                                <select name="Detalles[@i].CodigoProductoDetalleFactura" onchange="actualizarPrecio(this)" required>
                                    <option value="" data-precio="0.00">Seleccione</option>

                                    @if (!string.IsNullOrWhiteSpace(detalle.CodigoProductoDetalleFactura) && !productoSeleccionadoExiste)
                                    {
                                        <option value="@detalle.CodigoProductoDetalleFactura"
                                                data-precio="@detalle.PrecioUnitarioDetalleFactura.ToString("0.00", CultureInfo.InvariantCulture)"
                                                selected>
                                            Producto seleccionado
                                        </option>
                                    }

                                    @foreach (var producto in productos)
                                    {
                                        if (producto.CodigoProducto == detalle.CodigoProductoDetalleFactura)
                                        {
                                            <option value="@producto.CodigoProducto"
                                                    data-precio="@producto.PrecioUnitarioProducto.ToString("0.00", CultureInfo.InvariantCulture)"
                                                    selected>
                                                @producto.CodigoProducto - @producto.NombreProducto
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@producto.CodigoProducto"
                                                    data-precio="@producto.PrecioUnitarioProducto.ToString("0.00", CultureInfo.InvariantCulture)">
                                                @producto.CodigoProducto - @producto.NombreProducto
                                            </option>
                                        }
                                    }
                                </select>
                            </td>

                            <td class="text-center">
                                <input name="Detalles[@i].CantidadDetalleFactura"
                                       type="number"
                                       value="@detalle.CantidadDetalleFactura.ToString("0.##", CultureInfo.InvariantCulture)"
                                       min="0"
                                       step="any"
                                       inputmode="decimal"
                                       lang="en-US"
                                       data-decimal-positivo="true"
                                       required />
                            </td>

                            <td class="text-right">
                                <input name="Detalles[@i].PrecioUnitarioDetalleFactura"
                                       type="number"
                                       value="@detalle.PrecioUnitarioDetalleFactura.ToString("0.00", CultureInfo.InvariantCulture)"
                                       step="any"
                                       min="0"
                                       inputmode="decimal"
                                       lang="en-US"
                                       readonly
                                       required />
                            </td>

                            <td class="text-right">
                                <button class="action-btn" type="button" onclick="eliminarFila(this)">Quitar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <br />
            <button class="btn btn-outline" type="button" onclick="agregarFila()">Agregar producto/servicio</button>
        </div>

        <div class="actions">
            <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar factura</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let indiceDetalle = @detalles.Count;

        function actualizarPrecio(selectProducto) {
            const opcionSeleccionada = selectProducto.options[selectProducto.selectedIndex];
            const precio = opcionSeleccionada.getAttribute("data-precio") || "0.00";

            const fila = selectProducto.closest("tr");
            const inputPrecio = fila.querySelector("input[name$='.PrecioUnitarioDetalleFactura']");

            if (inputPrecio) {
                inputPrecio.value = parseFloat(precio).toFixed(2);
            }
        }

        function agregarFila() {
            const tbody = document.querySelector("#tablaDetalle tbody");
            const fila = document.createElement("tr");

            fila.innerHTML = `
                <td>
                    <select name="Detalles[${indiceDetalle}].CodigoProductoDetalleFactura" onchange="actualizarPrecio(this)" required>
                        <option value="" data-precio="0.00">Seleccione</option>
                        @foreach (var producto in productos)
                        {
                                <option value="@producto.CodigoProducto"
                                        data-precio="@producto.PrecioUnitarioProducto.ToString("0.00", CultureInfo.InvariantCulture)">
                                    @producto.CodigoProducto - @producto.NombreProducto
                                </option>
                        }
                    </select>
                </td>

                <td class="text-center">
        <input name="Detalles[${indiceDetalle}].CantidadDetalleFactura"
               type="number"
               value="1"
               min="0"
               step="any"
               inputmode="decimal"
               lang="en-US"
               data-decimal-positivo="true"
               required />

                <td class="text-right">
        <input name="Detalles[${indiceDetalle}].PrecioUnitarioDetalleFactura"
               type="number"
               value="0.00"
               step="any"
               min="0"
               inputmode="decimal"
               lang="en-US"
               readonly
               required />
                </td>

                <td class="text-right">
                    <button class="action-btn" type="button" onclick="eliminarFila(this)">Quitar</button>
                </td>
            `;

            tbody.appendChild(fila);
            indiceDetalle++;
        }

        function eliminarFila(boton) {
            const filas = document.querySelectorAll("#tablaDetalle tbody tr");

            if (filas.length <= 1) {
                alert("La factura debe tener al menos un producto o servicio.");
                return;
            }

            boton.closest("tr").remove();
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}