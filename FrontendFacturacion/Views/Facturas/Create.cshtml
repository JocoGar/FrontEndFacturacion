@using FrontendFacturacion.Services
@using System.Globalization
@model FrontendFacturacion.Services.FacturaCrearViewModel

@{
    ViewData["Title"] = "Nueva Factura";

    var clientes = ViewBag.Clientes as List<ClienteDto> ?? new();
    var productos = ViewBag.Productos as List<ProductoDto> ?? new();
    var usuarios = ViewBag.Usuarios as List<UsuarioDto> ?? new();

    var numeroFacturaInterno = $"F-{DateTime.Now:yyyyMMddHHmmss}";
}

<div class="page-title">
    <div>
        <h2>Crear Nueva Factura</h2>
        <p>Complete los datos generales y el detalle de productos o servicios.</p>
    </div>

    <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<div class="form-card">
    <form asp-controller="Facturas" asp-action="Create" method="post">
        <input asp-for="NumeroFactura" type="hidden" value="@numeroFacturaInterno" />

        <div class="form-section">
            <h3>1. Datos generales</h3>

            <div class="grid grid-3">
                <div class="form-group">
                    <label>Cliente</label>
                    <select asp-for="IdClienteFactura" required>
                        <option value="">Seleccione un cliente</option>
                        @foreach (var cliente in clientes)
                        {
                            <option value="@cliente.IdCliente">
                                @cliente.IdCliente - @cliente.NombreCliente @cliente.ApellidoCliente - NIT: @cliente.NitCliente
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Usuario vendedor</label>
                    <select asp-for="DpiUsuarioFactura" required>
                        <option value="">Seleccione un usuario</option>
                        @foreach (var usuario in usuarios)
                        {
                            <option value="@usuario.DpiUsuario">
                                @usuario.NombreUsuario @usuario.ApellidoUsuario
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Moneda</label>
                    <select asp-for="MonedaFactura">
                        <option>GTQ</option>
                        <option>USD</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Fecha de emisión</label>
                    <input asp-for="FechaEmisionFactura" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="form-group">
                    <label>Número de factura</label>
                    <input type="text" value="Generado automáticamente por la API" readonly />
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3>2. Detalle de productos o servicios</h3>

            <table id="tablaDetalle">
                <thead>
                    <tr>
                        <th>Producto / Servicio</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-right">Precio unitario</th>
                        <th class="text-right">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <select name="Detalles[0].CodigoProductoDetalleFactura" onchange="actualizarPrecio(this)" required>
                                <option value="" data-precio="0.00">Seleccione</option>
                                @foreach (var producto in productos)
                                {
                                    <option value="@producto.CodigoProducto"
                                            data-precio="@producto.PrecioUnitarioProducto.ToString("0.00", CultureInfo.InvariantCulture)">
                                        @producto.CodigoProducto - @producto.NombreProducto
                                    </option>
                                }
                            </select>
                        </td>
                        <td class="text-center">
                            <input name="Detalles[0].CantidadDetalleFactura" type="number" value="1" min="1" step="0.01" required />
                        </td>
                        <td class="text-right">
                            <input name="Detalles[0].PrecioUnitarioDetalleFactura"
                                   type="number"
                                   value="0.00"
                                   step="0.01"
                                   min="0"
                                   readonly
                                   required />
                        </td>
                        <td class="text-right">
                            <button class="action-btn" type="button" onclick="eliminarFila(this)">Quitar</button>
                        </td>
                    </tr>
                </tbody>
            </table>

            <br />
            <button class="btn btn-outline" type="button" onclick="agregarFila()">Agregar producto/servicio</button>
        </div>

        <div class="actions">
            <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar factura</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let indiceDetalle = 1;

        function actualizarPrecio(selectProducto) {
            const opcionSeleccionada = selectProducto.options[selectProducto.selectedIndex];
            const precio = opcionSeleccionada.getAttribute("data-precio") || "0.00";

            const fila = selectProducto.closest("tr");
            const inputPrecio = fila.querySelector("input[name$='.PrecioUnitarioDetalleFactura']");

            if (inputPrecio) {
                inputPrecio.value = parseFloat(precio).toFixed(2);
            }
        }

        function agregarFila() {
            const tbody = document.querySelector("#tablaDetalle tbody");
            const fila = document.createElement("tr");

            fila.innerHTML = `
                <td>
                    <select name="Detalles[${indiceDetalle}].CodigoProductoDetalleFactura" onchange="actualizarPrecio(this)" required>
                        <option value="" data-precio="0.00">Seleccione</option>
                        @foreach (var producto in productos)
                        {
                                <option value="@producto.CodigoProducto"
                                        data-precio="@producto.PrecioUnitarioProducto.ToString("0.00", CultureInfo.InvariantCulture)">
                                    @producto.CodigoProducto - @producto.NombreProducto
                                </option>
                        }
                    </select>
                </td>
                <td class="text-center">
                    <input name="Detalles[${indiceDetalle}].CantidadDetalleFactura" type="number" value="1" min="1" step="0.01" required />
                </td>
                <td class="text-right">
                    <input name="Detalles[${indiceDetalle}].PrecioUnitarioDetalleFactura"
                           type="number"
                           value="0.00"
                           step="0.01"
                           min="0"
                           readonly
                           required />
                </td>
                <td class="text-right">
                    <button class="action-btn" type="button" onclick="eliminarFila(this)">Quitar</button>
                </td>
            `;

            tbody.appendChild(fila);
            indiceDetalle++;
        }

        function eliminarFila(boton) {
            const filas = document.querySelectorAll("#tablaDetalle tbody tr");

            if (filas.length <= 1) {
                alert("La factura debe tener al menos un producto o servicio.");
                return;
            }

            boton.closest("tr").remove();
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("#tablaDetalle select").forEach(function (select) {
                actualizarPrecio(select);
            });
        });
    </script>
}