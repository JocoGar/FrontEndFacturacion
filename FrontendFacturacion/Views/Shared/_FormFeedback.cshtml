@{
    var mensajeApi = ViewBag.ApiError as string;
    var esConexion = ViewBag.ApiErrorEsConexion is bool valorConexion && valorConexion;

    if (!esConexion && !string.IsNullOrWhiteSpace(mensajeApi))
    {
        var mensajeLower = mensajeApi.ToLower();

        esConexion =
            mensajeLower.Contains("nodos") ||
            mensajeLower.Contains("servicio no está disponible") ||
            mensajeLower.Contains("tardó demasiado") ||
            mensajeLower.Contains("comunicación con el servicio");
    }
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="card" style="border-left: 4px solid #ef4444; margin-bottom: 16px;">
        <strong>Revise la información ingresada</strong>
        <div asp-validation-summary="All"></div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(mensajeApi))
{
    <div class="card" style="border-left: 4px solid #ef4444; margin-bottom: 16px;">
        @if (esConexion)
        {
            <strong>Problema de comunicación</strong>
        }
        else
        {
            <strong>No se pudo completar la operación</strong>
        }

        <p>@mensajeApi</p>
    </div>
}