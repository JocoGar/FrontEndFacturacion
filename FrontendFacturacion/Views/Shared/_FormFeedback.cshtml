@if (!ViewData.ModelState.IsValid)
{
    <div class="card" style="border-left: 4px solid #ef4444; margin-bottom: 16px;">
        <strong>Revise la información ingresada</strong>
        <div asp-validation-summary="All"></div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ViewBag.ApiError as string))
{
    <div class="card" style="border-left: 4px solid #ef4444; margin-bottom: 16px;">
        <strong>Error de comunicación con la API real</strong>
        <p>@ViewBag.ApiError</p>
        <p style="margin-bottom: 0;">No se están usando datos.</p>
    </div>
}