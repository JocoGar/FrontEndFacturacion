@model FrontendFacturacion.Services.CategoriaDto

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="page-title">
    <div>
        <h2>Editar Categoría</h2>
        <p>Modificación de categoría de producto o servicio.</p>
    </div>

    <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>
<partial name="_FormFeedback" />

<div class="form-card">
    <form asp-controller="Categorias" asp-action="Edit" asp-route-id="@Model.IdCategoriaProducto" method="post">
        <div class="form-section">
            <h3>Datos de la categoría</h3>

            <div class="grid grid-2">
                <div class="form-group">
                    <label>ID</label>
                    <input asp-for="IdCategoriaProducto" readonly />
                </div>

                <div class="form-group">
                    <label>Nombre de categoría</label>
                    <input asp-for="NombreCategoriaProducto" />
                </div>

                <div class="form-group" style="grid-column: 1 / -1;">
                    <label>Descripción</label>
                    <textarea asp-for="DescripcionCategoriaProducto"></textarea>
                </div>
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar cambios</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}