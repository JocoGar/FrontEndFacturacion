@model List<FrontendFacturacion.Services.CategoriaDto>

@{
    ViewData["Title"] = "Categorías";
}

<div class="page-title">
    <div>
        <h2>Categorías</h2>
        <p>Gestión de clasificaciones de productos.</p>
    </div>

    <a asp-controller="Categorias" asp-action="Create" class="btn btn-primary">Crear categoría</a>
</div>

<div class="table-card">
    <div class="table-header">
        <h3>Listado de categorías</h3>

        <form method="get" class="search-form">
            <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por ID, nombre o descripción..." />
            <button class="btn btn-outline" type="submit">Buscar</button>
            <a asp-action="Index" class="btn btn-outline">Limpiar</a>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre de categoría</th>
                <th>Descripción</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.IdCategoriaProducto</td>
                    <td>@categoria.NombreCategoriaProducto</td>
                    <td>@categoria.DescripcionCategoriaProducto</td>
                    <td>
                        <div class="actions">
                            <a asp-controller="Categorias" asp-action="Edit" asp-route-id="@categoria.IdCategoriaProducto" class="action-btn">Editar</a>

                            <form asp-controller="Categorias" asp-action="Delete" asp-route-id="@categoria.IdCategoriaProducto" method="post" class="inline-form">
                                <button class="action-btn" type="submit" onclick="return confirm('¿Eliminar categoría?')">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>