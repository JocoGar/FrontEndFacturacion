@{
    Layout = null;
    var esConexion = ViewBag.EsConexion is bool valorConexion && valorConexion;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso - Facturador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/logincustom.css" />
</head>

<body>
    <div class="login-card">
        <div class="d-flex flex-column align-items-center text-center">
            <div class="logo-box">F</div>
            <h1 class="brand-title">Facturador</h1>
            <p class="brand-subtitle">Sistema de Facturación</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2" style="font-size: 0.9rem; border-radius: 6px;" role="alert">
                @if (esConexion)
                {
                    <strong>Problema de comunicación</strong>
                    <br />
                }
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Cuenta" asp-action="Login" method="post">
            <div class="mb-3">
                <label for="nombreUsuario" class="form-label">Usuario</label>
                <input type="text"
                       class="form-control"
                       id="nombreUsuario"
                       name="nombreUsuario"
                       required
                       autofocus
                       autocomplete="off"
                       placeholder="Ingrese su DPI" />
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">Contraseña</label>
                <input type="password"
                       class="form-control"
                       id="password"
                       name="password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">Iniciar sesión</button>
        </form>
    </div>
</body>
</html>