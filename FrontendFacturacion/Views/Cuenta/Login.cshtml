@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso - Facturador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/logincustom.css" />

</head>


@*[INCIO][26/05/2026][Rodri][Formulario de Inicio de Sesión en el sistema de Facturación]*@
<body>
    @* El contenedor principal de la tarjeta de inicio de sesión *@
    <div class="login-card">
        <div class="d-flex flex-column align-items-center text-center">
            <div class="logo-box">F</div>
            <h1 class="brand-title">Facturador</h1>
            <p class="brand-subtitle">Sistema de Facturación</p>
        </div>

        @* El mensaje de error, si existe *@
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 text-center" style="font-size: 0.9rem; border-radius: 6px;" role="alert">
                @ViewBag.Error
            </div>
        }

        @* El formulario de inicio de sesión *@
        <form asp-controller="Cuenta" asp-action="Login" method="post">
            <div class="mb-3">
                <label for="nombreUsuario" class="form-label">Usuario</label>
                <input type="text" class="form-control" id="nombreUsuario" name="nombreUsuario" required autofocus autocomplete="off" />
            </div>
            <div class="mb-4">
                <label for="password" class="form-label">Contraseña</label>
                <input type="password" class="form-control" id="password" name="password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-2">Iniciar sesión</button>
        </form>
    </div>

</body>
</html>
@*[FIN][26/05/2026][Rodri][Formulario de Inicio de Sesión en el sistema de Facturación]*@