@model List<FrontendFacturacion.Services.UsuarioDto>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="page-title">
    @if (!string.IsNullOrWhiteSpace(ViewBag.ApiError as string))
    {
        <div class="card" style="border-left: 4px solid #ef4444; margin-bottom: 16px;">
            <strong>Error de comunicación con la API real</strong>
            <p>@ViewBag.ApiError</p>
            <p style="margin-bottom: 0;">No se están mostrando datos.</p>
        </div>
    }
    <div>
        <h2>Usuarios</h2>
        <p>Administración de accesos del sistema.</p>
    </div>

    <a asp-controller="Usuarios" asp-action="Create" class="btn btn-primary">Crear usuario</a>
</div>

<div class="table-card">
    <div class="table-header">
        <h3>Listado de usuarios</h3>

        <form method="get" class="search-form">
            <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por DPI, nombre, correo o rol..." />
            <button class="btn btn-outline" type="submit">Buscar</button>
            <a asp-action="Index" class="btn btn-outline">Limpiar</a>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>DPI</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Correo</th>
                <th>Rol</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.DpiUsuario</td>
                    <td>@usuario.NombreUsuario</td>
                    <td>@usuario.ApellidoUsuario</td>
                    <td>@usuario.CorreoUsuario</td>
                    <td><span class="badge badge-blue">@usuario.NombreRol</span></td>
                    <td>
                        <div class="actions">
                            <a asp-controller="Usuarios" asp-action="Edit" asp-route-id="@usuario.DpiUsuario" class="action-btn">Editar</a>

                            <form asp-controller="Usuarios" asp-action="Delete" asp-route-id="@usuario.DpiUsuario" method="post" class="inline-form">
                                <button class="action-btn" type="submit" onclick="return confirm('¿Eliminar usuario?')">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>