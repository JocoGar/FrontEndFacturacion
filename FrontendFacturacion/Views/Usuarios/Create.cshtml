@using FrontendFacturacion.Services
@model FrontendFacturacion.Services.UsuarioDto

@{
    ViewData["Title"] = "Crear Usuario";
    var roles = ViewBag.Roles as List<RolDto> ?? new();
}

<div class="page-title">
    <div>
        <h2>Crear Usuario</h2>
        <p>Formulario para registrar usuarios del sistema.</p>
    </div>

    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<div class="form-card">
    <form asp-controller="Usuarios" asp-action="Create" method="post">
        <div class="form-section">
            <h3>Datos del usuario</h3>

            <div class="grid grid-3">
                <div class="form-group">
                    <label>DPI</label>
                    <input asp-for="DpiUsuario" type="text" maxlength="13" placeholder="Ejemplo: 2948302910101" required />
                </div>

                <div class="form-group">
                    <label>Nombre</label>
                    <input asp-for="NombreUsuario" type="text" placeholder="Nombre del usuario" required />
                </div>

                <div class="form-group">
                    <label>Apellido</label>
                    <input asp-for="ApellidoUsuario" type="text" placeholder="Apellido del usuario" required />
                </div>

                <div class="form-group">
                    <label>Correo</label>
                    <input asp-for="CorreoUsuario" type="email" placeholder="usuario@empresa.com" />
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    <input asp-for="PasswordUsuario" type="password" placeholder="Contraseña temporal" required />
                </div>

                <div class="form-group">
                    <label>Rol</label>
                    <select asp-for="IdRol" required>
                        <option value="">Seleccione un rol</option>
                        @foreach (var rol in roles)
                        {
                            <option value="@rol.IdRol">@rol.NombreRol</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Fecha de creación</label>
                    <input asp-for="FechaCreacionUsuario" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar usuario</button>
        </div>
    </form>
</div>