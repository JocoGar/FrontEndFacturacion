@using FrontendFacturacion.Services
@model FrontendFacturacion.Services.UsuarioDto

@{
    ViewData["Title"] = "Crear Usuario";
    var roles = ViewBag.Roles as List<RolDto> ?? new();
}

<div class="page-title">
    <div>
        <h2>Crear Usuario</h2>
        <p>Formulario para registrar usuarios del sistema.</p>
    </div>

    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<partial name="_FormFeedback" />

<div class="form-card">
    <form asp-controller="Usuarios" asp-action="Create" method="post">
        <div class="form-section">
            <h3>Datos del usuario</h3>

            <div class="grid grid-3">
                <div class="form-group">
                    <label>DPI</label>
                    <input asp-for="DpiUsuario"
                           type="text"
                           maxlength="13"
                           inputmode="numeric"
                           data-solo-numeros="true"
                           placeholder="DPI de 13 dígitos"
                           required />
                    <span asp-validation-for="DpiUsuario" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Nombre</label>
                    <input asp-for="NombreUsuario"
                           type="text"
                           maxlength="50"
                           data-solo-letras="true"
                           placeholder="Nombre del usuario"
                           required />
                    <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Apellido</label>
                    <input asp-for="ApellidoUsuario"
                           type="text"
                           maxlength="100"
                           data-solo-letras="true"
                           placeholder="Apellido del usuario"
                           required />
                    <span asp-validation-for="ApellidoUsuario" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Correo</label>
                    <input asp-for="CorreoUsuario"
                           type="email"
                           maxlength="150"
                           placeholder="usuario@correo.com"
                           required />
                    <span asp-validation-for="CorreoUsuario" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    <input asp-for="PasswordUsuario"
                           type="password"
                           maxlength="100"
                           minlength="3"
                           required />
                    <span asp-validation-for="PasswordUsuario" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Rol</label>
                    <select asp-for="IdRol" required>
                        <option value="">Seleccione un rol</option>
                        @foreach (var rol in roles)
                        {
                            <option value="@rol.IdRol">@rol.NombreRol</option>
                        }
                    </select>
                    <span asp-validation-for="IdRol" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar usuario</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}