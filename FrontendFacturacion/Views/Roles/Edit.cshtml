@model FrontendFacturacion.Services.RolDto

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="page-title">
    <div>
        <h2>Editar Rol</h2>
        <p>Modificación de rol del sistema.</p>
    </div>

    <a asp-controller="Roles" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.IdRol" method="post">
        <div class="form-section">
            <h3>Datos del rol</h3>

            <div class="grid grid-2">
                <div class="form-group">
                    <label>Nombre del rol</label>
                    <input asp-for="NombreRol" />
                </div>
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Roles" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar cambios</button>
        </div>
    </form>
</div>