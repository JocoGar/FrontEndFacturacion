@model List<FrontendFacturacion.Services.RolDto>

@{
    ViewData["Title"] = "Roles";
}

<div class="page-title">
    @if (!string.IsNullOrWhiteSpace(ViewBag.ApiError as string))
    {
        <div class="card" style="border-left: 4px solid #ef4444; margin-bottom: 16px;">
            <strong>Error de comunicación con la API real</strong>
            <p>@ViewBag.ApiError</p>
            <p style="margin-bottom: 0;">No se están mostrando datos.</p>
        </div>
    }
    <div>
        <h2>Roles</h2>
        <p>Catálogo de roles del sistema.</p>
    </div>

    <a asp-controller="Roles" asp-action="Create" class="btn btn-primary">Crear rol</a>
</div>

<div class="table-card">
    <div class="table-header">
        <h3>Listado de roles</h3>

        <form method="get" class="search-form">
            <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por ID o nombre..." />
            <button class="btn btn-outline" type="submit">Buscar</button>
            <a asp-action="Index" class="btn btn-outline">Limpiar</a>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre del rol</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rol in Model)
            {
                <tr>
                    <td>@rol.IdRol</td>
                    <td>@rol.NombreRol</td>
                    <td>
                        <div class="actions">
                            <a asp-controller="Roles" asp-action="Edit" asp-route-id="@rol.IdRol" class="action-btn">Editar</a>

                            <form asp-controller="Roles" asp-action="Delete" asp-route-id="@rol.IdRol" method="post" class="inline-form">
                                <button class="action-btn" type="submit" onclick="return confirm('¿Eliminar rol?')">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>