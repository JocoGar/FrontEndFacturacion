@model List<FrontendFacturacion.Services.ProductoDto>

@{
    ViewData["Title"] = "Productos";
}

<div class="page-title">
    <div>
        <h2>Productos y Servicios</h2>
        <p>Gestión de productos o servicios disponibles para facturación.</p>
    </div>

    <a asp-controller="Productos" asp-action="Create" class="btn btn-primary">Nuevo producto/servicio</a>
</div>

<div class="table-card">
    <div class="table-header">
        <h3>Listado de productos y servicios</h3>

        <form method="get" class="search-form">
            <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar producto o servicio..." />
            <button class="btn btn-outline" type="submit">Buscar</button>
            <a asp-action="Index" class="btn btn-outline">Limpiar</a>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Código</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Descripción</th>
                <th class="text-right">Precio unitario</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.IdProducto</td>
                    <td>@producto.CodigoProducto</td>
                    <td>@producto.NombreProducto</td>
                    <td>@producto.NombreCategoriaProducto</td>
                    <td>@producto.DescripcionProducto</td>
                    <td class="text-right">Q@(producto.PrecioUnitarioProducto.ToString("N2"))</td>
                    <td>
                        <div class="actions">
                            <a asp-controller="Productos" asp-action="Edit" asp-route-id="@producto.IdProducto" class="action-btn">Editar</a>

                            <form asp-controller="Productos" asp-action="Delete" asp-route-id="@producto.IdProducto" method="post" class="inline-form">
                                <button class="action-btn" type="submit" onclick="return confirm('¿Eliminar producto/servicio?')">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>