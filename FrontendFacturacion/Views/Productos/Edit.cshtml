@using FrontendFacturacion.Services
@using System.Globalization
@model FrontendFacturacion.Services.ProductoDto

@{
    ViewData["Title"] = "Editar Producto o Servicio";
    var categorias = ViewBag.Categorias as List<CategoriaDto> ?? new();
}

<div class="page-title">
    <div>
        <h2>Editar Producto o Servicio</h2>
        <p>Modificación de producto o servicio facturable.</p>
    </div>

    <a asp-controller="Productos" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<partial name="_FormFeedback" />

<div class="form-card">
    <form asp-controller="Productos" asp-action="Edit" asp-route-id="@Model.IdProducto" method="post">
        <div class="form-section">
            <h3>Datos del producto o servicio</h3>

            <div class="grid grid-3">
                <div class="form-group">
                    <label>ID</label>
                    <input asp-for="IdProducto" readonly />
                </div>

                <div class="form-group">
                    <label>Código</label>
                    <input asp-for="CodigoProducto"
                           type="text"
                           maxlength="50"
                           data-alfanumerico-codigo="true"
                           readonly />
                    <span asp-validation-for="CodigoProducto" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Nombre</label>
                    <input asp-for="NombreProducto"
                           type="text"
                           maxlength="100"
                           required />
                    <span asp-validation-for="NombreProducto" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Categoría</label>
                    <select asp-for="IdCategoriaProducto" required>
                        <option value="">Seleccione una categoría</option>
                        @foreach (var categoria in categorias)
                        {
                            <option value="@categoria.IdCategoriaProducto">@categoria.NombreCategoriaProducto</option>
                        }
                    </select>
                    <span asp-validation-for="IdCategoriaProducto" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Precio unitario</label>
                    <input asp-for="PrecioUnitarioProducto"
                           type="number"
                           value="@Model.PrecioUnitarioProducto.ToString("0.00", CultureInfo.InvariantCulture)"
                           step="0.01"
                           min="0.01"
                           data-decimal-positivo="true"
                           required />
                    <span asp-validation-for="PrecioUnitarioProducto" class="text-danger"></span>
                </div>

                <div class="form-group" style="grid-column: 1 / -1;">
                    <label>Descripción</label>
                    <textarea asp-for="DescripcionProducto" maxlength="200"></textarea>
                    <span asp-validation-for="DescripcionProducto" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="actions">
            <a asp-controller="Productos" asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}