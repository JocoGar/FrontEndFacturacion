@using FrontendFacturacion.Services

@{
    ViewData["Title"] = "Nuevo Producto o Servicio";
    var categorias = ViewBag.Categorias as List<CategoriaDto> ?? new();
}

<div class="page-title">
    <div>
        <h2>Nuevo Producto o Servicio</h2>
        <p>Formulario preparado para registrar productos o servicios facturables.</p>
    </div>

    <a asp-controller="Productos" asp-action="Index" class="btn btn-outline">Regresar</a>
</div>

<div class="form-card">
    <div class="form-section">
        <h3>Datos del producto o servicio</h3>

        <div class="grid grid-3">
            <div class="form-group">
                <label>Código</label>
                <input type="text" placeholder="Ejemplo: PRD-001" />
            </div>

            <div class="form-group">
                <label>Nombre</label>
                <input type="text" placeholder="Nombre del producto o servicio" />
            </div>

            <div class="form-group">
                <label>Categoría</label>
                <select>
                    @foreach (var categoria in categorias)
                    {
                        <option value="@categoria.IdCategoriaProducto">@categoria.NombreCategoriaProducto</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Precio unitario</label>
                <input type="number" step="0.01" placeholder="0.00" />
            </div>

            <div class="form-group">
                <label>Precio costo</label>
                <input type="number" step="0.01" placeholder="0.00" />
            </div>

            <div class="form-group">
                <label>Fecha de creación</label>
                <input type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>

            <div class="form-group" style="grid-column: 1 / -1;">
                <label>Descripción</label>
                <textarea placeholder="Descripción del producto o servicio"></textarea>
            </div>
        </div>
    </div>

    <div class="actions">
        <a asp-controller="Productos" asp-action="Index" class="btn btn-outline">Cancelar</a>
        <button class="btn btn-primary">Guardar producto/servicio</button>
    </div>
</div>