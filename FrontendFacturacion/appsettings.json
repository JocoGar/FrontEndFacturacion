{
  "ApiSettings": {
    "BaseUrl": "http://localhost:5000",
    "UseMockData": false,
    "UseFallbackMockWhenApiFails": true,
    "TimeoutSeconds": 1,
    "RetryCount": 0,
    "CircuitBreakerFailures": 1,
    "CircuitBreakerSeconds": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "FrontendFacturacion.Services.FacturacionApiService": "Information"
    }
  },
  "AllowedHosts": "*"
}